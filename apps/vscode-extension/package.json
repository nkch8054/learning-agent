{
  "name": "nexus-learning",
  "displayName": "Nexus-Learning",
  "icon": "logo.png",
  "description": "An AI-powered tutor that lives inside your professional tools to teach you new skills in 15-second 'nudges' while you work, ensuring your expertise never goes obsolete.",
  "publisher": "NavinKumar",
  "version": "1.1.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/nkch8054/learning-agent"
  },
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:python",
    "onLanguage:go",
    "onLanguage:java",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nexusLearning.showLesson",
        "title": "Open Nexus Lesson"
      },
      {
        "command": "nexus.analyzeCode",
        "title": "Nexus: Analyze Code"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "nexus.analyzeCode",
          "group": "navigation",
          "when": "editorHasSelection"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.110.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "axios": "^1.13.6"
  }
}
